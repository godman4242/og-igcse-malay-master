{
    "$schema": "./.vscode/package-schema.json",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "prebuild": "node scripts/copy-ocr-assets.mjs",
        "build": "vite build",
        "ocr:assets": "node scripts/copy-ocr-assets.mjs",
        "ocr:fixtures": "node scripts/gen-ocr-fixtures.mjs",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
        "test:e2e:ui": "playwright test --config tests/e2e/playwright.config.js --ui",
        "install-githooks": "sh scripts/install-githooks.sh",
        "auto-sync": "node scripts/auto-sync.js",
        "gen:dict-icons": "node --env-file=.env.local scripts/generate-dict-icons.mjs",
        "gen:dict-icons-hf": "node --env-file=.env.local scripts/generate-dict-icons-hf.mjs",
        "gen:dict-icons-local": "node scripts/generate-dict-icons-local.mjs",
        "gen:flux-overnight": "node scripts/run-flux-overnight.mjs",
        "test:connections": "node scripts/test-connections.mjs",
        "postinstall": "if [ -z \"$CI\" ]; then npm run install-githooks; fi && node scripts/copy-ocr-assets.mjs"
    },
    "dependencies": {
        "@huggingface/inference": "4.13.16",
        "@supabase/supabase-js": "2.101.0",
        "@vercel/analytics": "2.0.1",
        "driver.js": "^1.4.0",
        "framer-motion": "12.38.0",
        "lucide-react": "1.7.0",
        "pdfjs-dist": "4.10.38",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-router-dom": "7.17.0",
        "tesseract.js": "^7.0.0",
        "ts-fsrs": "5.3.2",
        "zustand": "5.0.12"
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/vite": "4.2.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.1",
        "eslint": "9.39.4",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "globals": "17.4.0",
        "jsdom": "^29.1.1",
        "rollup-plugin-visualizer": "^7.0.1",
        "sharp": "0.34.5",
        "tailwindcss": "4.2.2",
        "vite": "8.0.14",
        "vite-plugin-pwa": "1.3.0",
        "vitest": "4.1.5"
    }
}
