{
    "$schema": "./.vscode/package-schema.json",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "prebuild": "node scripts/copy-ocr-assets.mjs && node scripts/copy-asr-assets.mjs",
        "build": "vite build",
        "ocr:assets": "node scripts/copy-ocr-assets.mjs",
        "ocr:fixtures": "node scripts/gen-ocr-fixtures.mjs",
        "asr:assets": "node scripts/copy-asr-assets.mjs",
        "asr:fixtures": "node scripts/gen-asr-fixtures.mjs",
        "build:en-dict": "node scripts/build-en-dictionary.mjs",
        "build:en-freq": "node scripts/build-english-frequency.mjs",
        "lint": "eslint . --max-warnings 3",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
        "chaos": "node scripts/chaos/chaos.mjs",
        "chaos:check": "node scripts/chaos/chaos.mjs --check",
        "test:e2e:ui": "playwright test --config tests/e2e/playwright.config.js --ui",
        "launch-gate": "node ../agent-harness/harness/launch-gate/launch-gate.mjs",
        "launch-gate:static": "node ../agent-harness/harness/launch-gate/launch-gate.mjs --static",
        "install-githooks": "sh scripts/install-githooks.sh",
        "auto-sync": "node scripts/auto-sync.js",
        "gen:dict-icons": "node --env-file=.env.local scripts/generate-dict-icons.mjs",
        "gen:dict-icons-hf": "node --env-file=.env.local scripts/generate-dict-icons-hf.mjs",
        "gen:dict-icons-local": "node scripts/generate-dict-icons-local.mjs",
        "gen:flux-overnight": "node scripts/run-flux-overnight.mjs",
        "test:connections": "node scripts/test-connections.mjs",
        "eval:ai-tier": "node --import ./scripts/lib/extless-resolver.mjs scripts/ai-tier-eval/harness.mjs",
        "postinstall": "if [ -z \"$CI\" ]; then npm run install-githooks; fi && node scripts/copy-ocr-assets.mjs && node scripts/copy-asr-assets.mjs"
    },
    "dependencies": {
        "@huggingface/inference": "4.13.30",
        "@huggingface/transformers": "^3.8.1",
        "@supabase/supabase-js": "2.117.1",
        "@vercel/analytics": "2.0.1",
        "driver.js": "^1.8.0",
        "framer-motion": "12.38.0",
        "lucide-react": "1.48.0",
        "pdfjs-dist": "4.10.38",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router-dom": "7.18.4",
        "tesseract.js": "^7.0.0",
        "ts-fsrs": "5.4.2",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "4.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "axe-core": "4.13.0",
        "eslint": "9.39.4",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.12.0",
        "js-yaml": "^4.3.2",
        "jsdom": "^29.1.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "sharp": "0.35.4",
        "tailwindcss": "4.3.3",
        "vite": "8.3.0",
        "vite-plugin-pwa": "1.3.0",
        "vitest": "4.1.5",
        "wavefile": "^11.0.0"
    }
}
