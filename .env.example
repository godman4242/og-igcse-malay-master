# Environment Configuration
# Copy this file to .env.local (gitignored) and fill in your own values.
#
# IMPORTANT: every VITE_* variable is INLINED into the production bundle at
# build time. That means anyone who inspects the deployed JS / network tab
# can read these keys. Restrict each key in its provider's console:
#   • Google Cloud key   — restrict to "Cloud Translation API" only AND to
#                          your domain's HTTP referrer.
#   • DeepL key          — DeepL Free is free up to 500k chars/month.
#   • Gemini key         — restrict to "Generative Language API" only.
# If you ever paste a key in chat / a screenshot / a public repo, rotate it.

# ───── Phase 1: Supabase Backend (optional cloud sync) ─────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key-here

# ── Vercel server-side env vars (NOT VITE_ — never exposed to the browser) ──
# Set these in Vercel → Project Settings → Environment Variables.
# Also add to .env.local for local `vercel dev`.

# Supabase service role key — for JWT verification in api/gemini.js
# Find it: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ───── Translation providers ─────
# Keys now live SERVER-SIDE in Vercel environment variables (not VITE_ prefixed).
# Set DEEPL_KEY and GOOGLE_TRANSLATE_KEY in your Vercel project settings.
# Then flip the VITE_ flags below to true so the client knows the provider is active.

# Set to "true" when DEEPL_KEY is configured in Vercel
VITE_DEEPL_ENABLED=false

# Set to "true" when GOOGLE_TRANSLATE_KEY is configured in Vercel
VITE_GOOGLE_TRANSLATE_ENABLED=false

# For local dev: add these to .env.local (gitignored) and Vercel will read them
# DEEPL_KEY=your-deepl-key-here
# GOOGLE_TRANSLATE_KEY=your-google-key-here

# ───── Writing tutor / chatbot AI ─────
# Gemini (free tier: 15 req/min, 1M tokens/day on Flash) —
# https://aistudio.google.com/app/apikey
VITE_GEMINI_KEY=

# OpenRouter (free models: DeepSeek, Llama, Gemma) —
# https://openrouter.ai/keys
VITE_OPENROUTER_KEY=

# Claude API via Supabase Edge Function (paid).
# Used for the Cikgu Maya tutor when neither Gemini nor OpenRouter is set.
VITE_CLAUDE_API_KEY=

# Set to "true" to use canned mock responses instead of calling any API
VITE_AI_MOCK=true

# ───── Analytics / deployment (optional) ─────
VITE_POSTHOG_KEY=
VITE_PLAUSIBLE_DOMAIN=

# App environment marker
# Options: development, staging, production
VITE_APP_ENV=development
