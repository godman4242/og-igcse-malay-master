# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Obsidian per-machine editor state — not part of the app
.obsidian/

# Env files — keep .env.example in repo, never commit real keys
.env
.env.*
!.env.example

# Supabase CLI working directory — local, regenerated by `supabase link`
supabase/.temp/

# Playwright artifacts — generated, not source of truth
test-results/
playwright-report/
playwright/.cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.understand-anything/


# Transient Claude Code scheduler lock (not for version control)
.claude/scheduled_tasks.lock

# Visual Companion (brainstorming) throwaway mockups
.superpowers/

# OCR engine: WASM core variants + worker are regenerated from the tesseract.js
# dep by scripts/copy-ocr-assets.mjs (postinstall + prebuild), so they're never
# committed (~20 MB). The language models (public/ocr/lang/*.gz) ARE committed so
# the build needs no network fetch.
public/ocr/core/
public/ocr/worker.min.js

# ASR (audio transcription) — Task-0 spike + self-hosted assets.
# Throwaway spike artifacts (FLEURS WER fixtures, Python venv, cloned converter,
# raw conversion output) — never committed.
tmp-asr-fixtures/
.venv-asr/
transformers.js/
mesolitica-onnx/
# Self-hosted ASR assets (ORT-Web WASM + converted Whisper ONNX model) are
# regenerated by scripts/copy-asr-assets.mjs; large, never committed. (Task 4 may
# later un-ignore the small JSON config/tokenizer under public/asr/model/.)
public/asr/
